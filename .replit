entrypoint = "main.py"
modules = ["python-3.10", "nodejs-20", "python3", "postgresql-16"]

hidden = [".pythonlibs"]

[nix]
channel = "stable-23_05"
packages = ["glibcLocales", "rapidfuzz-cpp", "taskflow"]

[deployment]
run = ["sh", "-c", "python3 main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34339
externalPort = 3003

[[ports]]
localPort = 34423
externalPort = 3000

[[ports]]
localPort = 40987
externalPort = 3001

[[ports]]
localPort = 41693
externalPort = 3002

[agent]
expertMode = true
integrations = ["javascript_log_in_with_replit:1.0.0", "javascript_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flask App"

[[workflows.workflow]]
name = "Flask App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn main:app --bind 0.0.0.0:5000 --workers 2 --threads 4 --timeout 60 --access-logfile - --error-logfile -"
waitForPort = 5000
